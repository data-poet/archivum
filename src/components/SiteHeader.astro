---
/**
 * SiteHeader.astro — Site-wide nav bar, used by every page.
 *
 * Previously six pages (home, WikiLayout, religions/index, races/index,
 * search, tags/[tag]) each hand-rolled their own near-identical header —
 * same classes, same logo, but subtly different nav links (some static,
 * one built client-side via script). Adding a nav item meant editing six
 * files and likely missing one. This is the single replacement.
 *
 * Two dropdown selectors, always shown the same way on every page — no more
 * conditional "full nav vs restricted nav" logic based on page depth:
 *   - Features:      Mapas, Linha do Tempo, … — sourced from shared/features.ts.
 *                     Add a feature there and it shows up automatically.
 *   - Content types:  Religiões, Raças, … — sourced from content/meta.ts's
 *                     COLLECTION_META, same as before. Add a collection there
 *                     and it shows up automatically.
 *
 * Built with <details>/<summary> rather than a hydrated component — this is
 * open/close-only interactivity, so it doesn't need client:load.
 *
 * Usage:
 *   <SiteHeader />                                                — neither selector highlighted (e.g. /search, /tags/[tag])
 *   <SiteHeader activeSection="religions" />                      — content selector shows "Religiões"
 *   <SiteHeader activeFeature="maps" />                           — features selector shows "Mapas" (once available)
 *   <SiteHeader maxWidthClass="max-w-screen-2xl xl:px-6 2xl:px-8" /> — wider layout (article pages)
 */
import { collections as collectionConfig } from '@/content/config';
import { metaFor } from '@/content/meta';
import { FEATURES, featureFor } from '@/shared/features';
import { FOCUS_RING } from '@/shared/a11y';

interface Props {
  /** Collection key to highlight as the current content type, if any. */
  activeSection?: string;
  /** Feature key to highlight as the current feature, if any. */
  activeFeature?: string;
  /** Overrides the header's inner max-width/padding classes. */
  maxWidthClass?: string;
}

const { activeSection, activeFeature, maxWidthClass = 'max-w-6xl' } = Astro.props;

const collectionKeys = Object.keys(collectionConfig);

const activeCollectionMeta = activeSection ? metaFor(activeSection) : undefined;
const contentTriggerLabel = activeCollectionMeta?.label ?? 'Conteúdo';

const activeFeatureMeta = activeFeature ? featureFor(activeFeature) : undefined;
const featureTriggerLabel = activeFeatureMeta?.label ?? 'Recursos';

const summaryBaseClass =
  `list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none px-2 py-1 rounded flex items-center gap-1 hover:text-accent transition-colors ${FOCUS_RING}`;

const menuPanelClass =
  'absolute left-0 top-full mt-1 min-w-[10rem] bg-parchment-50 border border-border rounded shadow-lg py-1 z-50';

const menuItemClass =
  `block px-3 py-1.5 whitespace-nowrap hover:bg-parchment-100 hover:text-accent transition-colors ${FOCUS_RING}`;
---

<header class="border-b border-border bg-parchment-50/70 backdrop-blur sticky top-0 z-50">
  <div class={`${maxWidthClass} mx-auto px-4 py-2 sm:h-12 sm:py-0 flex flex-wrap items-center gap-x-4 gap-y-2 sm:flex-nowrap sm:gap-6`}>

    <a
      href="/"
      class={`shrink-0 font-serif font-bold text-accent text-lg tracking-tight no-underline hover:no-underline rounded ${FOCUS_RING}`}
    >
      📜 Archivum
    </a>

    <nav class="order-3 w-full sm:order-none sm:w-auto flex gap-2 text-sm text-ink-muted font-sans">

      {/* Features selector: Mapas, Linha do Tempo, … */}
      <details class="relative group">
        <summary class={`${summaryBaseClass} ${activeFeatureMeta ? 'text-accent font-semibold' : ''}`}>
          {featureTriggerLabel}
          <span class="text-[0.6rem] text-ink-light group-open:rotate-180 transition-transform">▾</span>
        </summary>
        <div class={menuPanelClass}>
          {FEATURES.map((feature) => {
            const isActive = feature.key === activeFeature;
            return feature.available ? (
              <a
                href={feature.href}
                class={`${menuItemClass} ${isActive ? 'text-accent font-semibold' : ''}`}
              >
                {feature.label}
              </a>
            ) : (
              <span
                class="block px-3 py-1.5 whitespace-nowrap text-ink-light/60 cursor-not-allowed select-none"
                title="Em desenvolvimento"
              >
                {feature.label}
              </span>
            );
          })}
        </div>
      </details>

      {/* Content type selector: Religiões, Raças, … */}
      <details class="relative group">
        <summary class={`${summaryBaseClass} ${activeCollectionMeta ? 'text-accent font-semibold' : ''}`}>
          {contentTriggerLabel}
          <span class="text-[0.6rem] text-ink-light group-open:rotate-180 transition-transform">▾</span>
        </summary>
        <div class={menuPanelClass}>
          {collectionKeys.map((key) => {
            const meta = metaFor(key);
            const isActive = key === activeSection;
            return (
              <a
                href={meta.href}
                class={`${menuItemClass} ${isActive ? 'text-accent font-semibold' : ''}`}
              >
                {meta.label}
              </a>
            );
          })}
        </div>
      </details>

    </nav>

    <div class="flex items-center gap-2 flex-1 min-w-0 sm:flex-none sm:ml-auto">
      <form action="/search" method="get" class="flex flex-1 min-w-0 sm:flex-none">
        <input
          name="q"
          type="search"
          placeholder="Buscar…"
          class={`w-full min-w-0 sm:w-48 border border-border rounded-l px-3 py-1 text-sm font-sans bg-parchment-50 focus:outline-none focus:ring-1 focus:ring-accent ${FOCUS_RING}`}
        />
        <button
          type="submit"
          class={`shrink-0 border border-l-0 border-border rounded-r px-3 py-1 text-sm font-sans bg-parchment-100 hover:bg-parchment-200 transition-colors ${FOCUS_RING}`}
        >
          Ir
        </button>
      </form>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Alternar tema claro/escuro"
        aria-pressed="false"
        class={`shrink-0 w-8 h-8 flex items-center justify-center rounded border border-border hover:bg-parchment-100 transition-colors ${FOCUS_RING}`}
      >
        <span aria-hidden="true" class="dark:hidden">🌙</span>
        <span aria-hidden="true" class="hidden dark:inline">☀️</span>
      </button>
    </div>

  </div>
</header>

<script>
import { THEME_STORAGE_KEY } from '@/shared/theme';

const button = document.getElementById('theme-toggle');

function isDark(): boolean {
  return document.documentElement.dataset.theme === 'dark';
}

function setDark(dark: boolean) {
  if (dark) {
    document.documentElement.dataset.theme = 'dark';
  } else {
    delete document.documentElement.dataset.theme;
  }
  button?.setAttribute('aria-pressed', String(dark));
}

setDark(isDark());

button?.addEventListener('click', () => {
  const next = !isDark();
  localStorage.setItem(THEME_STORAGE_KEY, next ? 'dark' : 'light');
  setDark(next);
});

// Follows the OS theme live, but only for visitors who never explicitly
// chose one — an explicit choice in localStorage always wins.
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
  if (localStorage.getItem(THEME_STORAGE_KEY)) return;
  setDark(e.matches);
});
</script>
