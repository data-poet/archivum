---
import '../styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import { FOCUS_RING } from '@/shared/a11y';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Página não encontrada – Archivum</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body>

  <SiteHeader />

  <main class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="font-serif text-7xl font-bold text-accent mb-4">404</p>
    <h1 class="font-serif text-2xl font-bold text-ink mb-3">
      Esta página não existe no Archivum.
    </h1>
    <p class="font-sans text-ink-light mb-8">
      O pergaminho que você procura pode ter sido perdido, renomeado ou nunca escrito.
    </p>
    <a
      href="/"
      class={`inline-block font-sans text-sm text-white bg-accent hover:bg-accent-hover px-4 py-2 rounded transition-colors ${FOCUS_RING}`}
    >
      Voltar à Página Principal
    </a>
  </main>

</body>
</html>
