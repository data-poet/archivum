---
/**
 * races/index.astro — Races listing page
 *
 * Displays all entries grouped by type with anchor links for quick navigation.
 */
import { getCollection } from 'astro:content';
import SiteHeader from '@/components/SiteHeader.astro';
import '../../styles/global.css';

const all = await getCollection('races', ({ data }) => !data.draft);
all.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Section definitions — type values match the Zod enum in config.ts
const sections = [
  { type: 'race',     label: 'Raças',     icon: '⚔', color: '#2d5a2d', bg: '#e8f5e8' },
  { type: 'sub-race', label: 'Sub-raças', icon: '🐉', color: '#1e3a5f', bg: '#e8eef8' },
] as const;

// Returns a short subtitle string for each entry type
function subtitle(data: any): string | null {
  switch (data.type) {
    case 'race':     return data.vision ?? null;
    case 'sub-race': return data.parentRace ? `Sub-raça de ${data.parentRace.label}` : null;
    default:         return null;
  }
}
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Raças – Archivum</title>
</head>
<body>

  <!-- Navigation -->
  <SiteHeader activeSection="races" />

  <main class="max-w-4xl mx-auto px-4 py-8">

    <h1 class="font-serif text-3xl font-bold border-b border-border pb-2 mb-2">Raças</h1>
    <p class="font-sans text-sm text-ink-light mb-6">{all.length} artigos</p>

    <!-- Quick-jump filter pills -->
    <div class="flex flex-wrap gap-2 mb-8">
      {sections.map(({ type, label, color, bg }) => {
        const c = all.filter((e) => e.data.type === type).length;
        return (
          <a
            href={`#${type}`}
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-sans font-semibold border transition-opacity hover:opacity-70"
            style={`color:${color}; background-color:${bg}; border-color:${color}40`}
          >
            {label}
            <span class="text-xs opacity-70">({c})</span>
          </a>
        );
      })}
    </div>

    <!-- Sections grouped by type -->
    <div class="space-y-6">

      {sections.map(({ type, label, icon, color }) => {

        const entries = all.filter((e) => e.data.type === type);

        return (

          <details
            id={type}
            class="group"
            open
          >

            <!-- Expandable Header -->
            <summary
              class="list-none cursor-pointer select-none"
            >

              <div
                class="flex items-center gap-2 px-4 py-2 rounded font-serif font-bold text-white text-base"
                style={`background-color:${color}`}
              >

                <!-- Arrow -->
                <span class="transition-transform group-open:rotate-90">
                  ▶
                </span>

                <span>{icon}</span>

                <span>{label}</span>

                <span class="font-sans font-normal text-xs opacity-80 ml-1">
                  ({entries.length})
                </span>

              </div>

            </summary>

            <!-- Expandable Content -->
            <ul class="divide-y divide-border border border-t-0 border-border rounded-b bg-parchment-100">

              {entries.map((entry) => {

                const sub = subtitle(entry.data);

                return (
                  <li>

                    <a
                      href={`/races/${entry.slug}`}
                      class="flex items-baseline gap-3 px-5 py-3 hover:bg-parchment-200 transition-colors"
                    >

                      <span class="font-serif font-bold text-accent">
                        {entry.data.title}
                      </span>

                      {sub && (
                        <span class="text-ink-light font-sans text-sm">
                          {sub}
                        </span>
                      )}

                      {entry.data.description && (
                        <span class="text-ink-muted font-sans text-sm ml-auto truncate max-w-xs">
                          {entry.data.description}
                        </span>
                      )}

                    </a>

                  </li>
                );
              })}

              {entries.length === 0 && (
                <li class="px-5 py-4 font-sans text-ink-light italic">
                  Nenhum artigo ainda.
                </li>
              )}

            </ul>

          </details>

        );
      })}

    </div>

  </main>
</body>
</html>
